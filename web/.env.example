NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API (Settings → API). Vacío = sitio usa seed local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret del proyecto (Dashboard → Settings → API → JWT Secret). Solo server.
# Usado para verificar el access token además de getUser(). Obligatorio en producción.
SUPABASE_JWT_SECRET=

# Postgres solo para migraciones (Settings → Database). No commitear.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# En producción con Supabase: no mostrar seed si la DB está vacía.
# true = forzar seed; false = nunca seed. Por defecto: seed solo si no hay Supabase o NODE_ENV≠production.
ALLOW_CONTENT_FALLBACK=

RESEND_API_KEY=
CONTACT_TO_EMAIL=contactenos@lcs.pe
CONTACT_FROM_EMAIL=LCS Web <onboarding@resend.dev>

# Cloudflare Turnstile (anti-bot contacto). Obligatorio en producción.
# Dashboard: https://dash.cloudflare.com/ → Turnstile
# Test keys (siempre pasan): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
